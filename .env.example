# ===========================
# Application
# ===========================
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================
# Database (PostgreSQL 16)
# ===========================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=encf_db
DB_USER=encf_user
DB_PASSWORD=encf_password

# ===========================
# Redis 7
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=encf_redis_pass

# ===========================
# MinIO / S3 Storage
# ===========================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=encf_minio_access
MINIO_SECRET_KEY=encf_minio_secret
MINIO_BUCKET_XML=encf-xml
MINIO_BUCKET_PDF=encf-pdf
MINIO_USE_SSL=false

# ===========================
# JWT Authentication (RS256)
# ===========================
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m

# ===========================
# Encryption (Certificates)
# ===========================
ENCRYPTION_KEY=your-256-bit-encryption-key-here-base64

# ===========================
# Email / SMTP
# ===========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@e-ncf.do

# ===========================
# DGII Endpoints (REST e-CF)
# ===========================
# Ambiente = segmento de ruta con capitalización EXACTA: TesteCF (pruebas), CerteCF (certificación), eCF (producción)
# Autenticación: GET semilla -> firmar -> POST multipart validarsemilla -> token JSON. Envío e-CF: POST multipart.
DGII_AMBIENTE=certificacion
# --- Certificación (CerteCF) ---
DGII_SEMILLA_URL=https://ecf.dgii.gov.do/CerteCF/Autenticacion/api/Autenticacion/Semilla
DGII_TOKEN_URL=https://ecf.dgii.gov.do/CerteCF/autenticacion/api/Autenticacion/ValidarSemilla
DGII_ECF_URL=https://ecf.dgii.gov.do/CerteCF/recepcion/api/FacturasElectronicas
DGII_RFCE_URL=https://fc.dgii.gov.do/CerteCF/recepcionfc/api/recepcion/ecf
DGII_ESTADO_URL=https://ecf.dgii.gov.do/CerteCF/consultaresultado/api/Consultas/Estado
DGII_STATUS_ENDPOINT=https://ecf.dgii.gov.do/CerteCF/consultaresultado/api/Consultas/Estado
DGII_ACECF_URL=https://ecf.dgii.gov.do/CerteCF/aprobacionComercial/api/AprobacionComercial
DGII_ANULACION_URL=https://ecf.dgii.gov.do/CerteCF/anulacionrangos/api/operaciones/anularrango
DGII_RNC_URL=https://ecf.dgii.gov.do/CerteCF/consultarnc/api/Consultas/rnc
# URLs de consulta de timbre (para el QR del PDF), por tipo de comprobante:
DGII_QR_URL=https://ecf.dgii.gov.do/CerteCF/consultatimbre
DGII_QR_FC_URL=https://fc.dgii.gov.do/CerteCF/consultatimbrefc

# --- Producción (descomentar y usar en el servidor real; segmento eCF) ---
# DGII_AMBIENTE=produccion
# DGII_SEMILLA_URL=https://ecf.dgii.gov.do/eCF/Autenticacion/api/Autenticacion/Semilla
# DGII_TOKEN_URL=https://ecf.dgii.gov.do/eCF/autenticacion/api/Autenticacion/ValidarSemilla
# DGII_ECF_URL=https://ecf.dgii.gov.do/eCF/recepcion/api/FacturasElectronicas
# DGII_RFCE_URL=https://fc.dgii.gov.do/eCF/recepcionfc/api/recepcion/ecf
# DGII_ESTADO_URL=https://ecf.dgii.gov.do/eCF/consultaresultado/api/Consultas/Estado
# DGII_STATUS_ENDPOINT=https://ecf.dgii.gov.do/eCF/consultaresultado/api/Consultas/Estado
# DGII_ACECF_URL=https://ecf.dgii.gov.do/eCF/aprobacionComercial/api/AprobacionComercial
# DGII_ANULACION_URL=https://ecf.dgii.gov.do/eCF/anulacionrangos/api/operaciones/anularrango
# DGII_RNC_URL=https://ecf.dgii.gov.do/eCF/consultarnc/api/Consultas/rnc
# DGII_QR_URL=https://ecf.dgii.gov.do/eCF/consultatimbre
# DGII_QR_FC_URL=https://fc.dgii.gov.do/eCF/consultatimbrefc

# ===========================
# DGII Polling Configuration
# ===========================
DGII_POLLING_INTERVAL_MS=300000

# ===========================
# Backup Configuration
# ===========================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
