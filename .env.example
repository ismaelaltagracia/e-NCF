# ===========================
# Application
# ===========================
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================
# Database (PostgreSQL 16)
# ===========================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=encf_db
DB_USER=encf_user
DB_PASSWORD=encf_password

# ===========================
# Redis 7
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=encf_redis_pass

# ===========================
# MinIO / S3 Storage
# ===========================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=encf_minio_access
MINIO_SECRET_KEY=encf_minio_secret
MINIO_BUCKET_XML=encf-xml
MINIO_BUCKET_PDF=encf-pdf
MINIO_USE_SSL=false

# ===========================
# JWT Authentication (RS256)
# ===========================
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m

# ===========================
# Encryption (Certificates)
# ===========================
ENCRYPTION_KEY=your-256-bit-encryption-key-here-base64

# ===========================
# DGII Endpoints
# ===========================
DGII_SEMILLA_URL=https://ecf.dgii.gov.do/CerteCF/WSCertificacion/CertECF.asmx
DGII_TOKEN_URL=https://ecf.dgii.gov.do/CerteCF/WSCertificacion/CertECF.asmx
DGII_ECF_URL=https://ecf.dgii.gov.do/CerteCF/WSCertificacion/CertECFComunicacion.asmx
DGII_ESTADO_URL=https://ecf.dgii.gov.do/CerteCF/ConsultaEstado/ConsultaEstadoCertECF.asmx
DGII_RNC_URL=https://dgii.gov.do/app/WebApps/ConsultasWeb2/ConsultasWeb/consultas/rnc.aspx

# ===========================
# Backup Configuration
# ===========================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
